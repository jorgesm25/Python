# Importamos la función pyfetch del módulo pyodide.http, 
# que permite realizar solicitudes HTTP asíncronas dentro de un entorno Pyodide (Python en el navegador).
from pyodide.http import pyfetch

# Definimos la URL desde donde se va a descargar el archivo CSV.
filename = "https://cf-courses-data.s3.us.cloud-object-storage.appdomain.cloud/IBMDeveloperSkillsNetwork-PY0101EN-SkillsNetwork/labs/Module%205/data/addresses.csv"

# Definimos una función asíncrona llamada 'download' para descargar un archivo desde una URL dada.
async def download(url, filename):
    # Realizamos la solicitud HTTP GET a la URL usando pyfetch y esperamos la respuesta.
    response = await pyfetch(url)
    
    # Verificamos si la solicitud fue exitosa (código de estado 200).
    if response.status == 200:
        # Abrimos un archivo local con el nombre especificado en modo escritura binaria ("wb").
        with open(filename, "wb") as f:
            # Escribimos el contenido de la respuesta en el archivo, obteniéndolo en formato binario.
            f.write(await response.bytes())

# Llamamos a la función download para descargar el archivo CSV desde la URL especificada y 
# lo guardamos localmente como "addresses.csv".
await download(filename, "addresses.csv")

# Leemos el archivo CSV guardado en un DataFrame de pandas sin considerar una fila de encabezado (header=None).
df = pd.read_csv("addresses.csv", header=None)

