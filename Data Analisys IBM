# Mostramos el gráfico.
plt.show()
#--------------------------------------- REGRESSION LINEAL MULTIPLE-----------------
#Inicializamos un objeto de regresión
lm = LinearRegression()

# Definimos la variable independiente Z como un DataFrame que contiene varias características:
# 'horsepower', 'curb-weight', 'engine-size' y 'highway-mpg'.
Z = df[['horsepower', 'curb-weight', 'engine-size', 'highway-mpg']]

# Ajustamos el modelo de regresión lineal utilizando las variables en Z (independientes) para predecir 'price' (dependiente).
