################## En este tutorial, creó una base de datos y una tabla en un cuaderno de Python usando SQLite3. Luego creó una tabla e insertó algunas filas de datos en ella. Luego consultó los datos. También recuperó los datos en un marco de datos de pandas.

# Importa la librería sqlite3 para trabajar con bases de datos SQLite
import sqlite3

# Conecta a la base de datos SQLite llamada 'INSTRUCTOR.db'.
# Si la base de datos no existe, se crea automáticamente en el directorio actual.
conn = sqlite3.connect('INSTRUCTOR.db')

# Crea un objeto cursor para ejecutar comandos SQL en la base de datos.
cursor_obj = conn.cursor()

# Elimina la tabla 'INSTRUCTOR' si ya existe en la base de datos.
cursor_obj.execute("DROP TABLE IF EXISTS INSTRUCTOR")

# Crea la tabla 'INSTRUCTOR' si no existe.
# La tabla tiene cinco columnas: ID, FNAME, LNAME, CITY y CCODE.
# La columna ID es la clave primaria y no puede ser nula.
table = """ 
CREATE TABLE IF NOT EXISTS INSTRUCTOR(
    ID INTEGER PRIMARY KEY NOT NULL, 
    FNAME VARCHAR(20), 
    LNAME VARCHAR(20), 
    CITY VARCHAR(20), 
    CCODE CHAR(2)
);
"""
cursor_obj.execute(table)

print("La tabla está lista")

# Inserta una fila en la tabla 'INSTRUCTOR'.
cursor_obj.execute('''INSERT INTO INSTRUCTOR VALUES (1, 'Rav', 'Ahuja', 'TORONTO', 'CA')''')

# Inserta varias filas en la tabla 'INSTRUCTOR'.
cursor_obj.execute('''INSERT INTO INSTRUCTOR VALUES 
(2, 'Raul', 'Chong', 'Markham', 'CA'), 
(3, 'Hima', 'Vasudevan', 'Chicago', 'US')''')

# Consulta todos los datos de la tabla 'INSTRUCTOR'.
statement = '''SELECT * FROM INSTRUCTOR'''
cursor_obj.execute(statement)

# Muestra todos los datos obtenidos de la consulta.
print("Todos los datos:")
output_all = cursor_obj.fetchall()
for row_all in output_all:
    print(row_all)

# Consulta y muestra solo algunas filas de la tabla 'INSTRUCTOR'.
statement = '''SELECT * FROM INSTRUCTOR'''
cursor_obj.execute(statement)

print("Algunos datos:")
# fetchmany(2) obtiene las primeras dos filas de la tabla.
output_many = cursor_obj.fetchmany(2)
for row_many in output_many:
    print(row_many)

# Consulta y muestra solo la columna FNAME de la tabla 'INSTRUCTOR'.
statement = '''SELECT FNAME FROM INSTRUCTOR'''
cursor_obj.execute(statement)

print("Nombres:")
output_column = cursor_obj.fetchall()
for fetch in output_column:
    print(fetch)

# Actualiza la ciudad (CITY) de la fila donde FNAME es 'Rav' a 'MOOSETOWN'.
query_update = '''UPDATE INSTRUCTOR SET CITY='MOOSETOWN' WHERE FNAME="Rav"'''
cursor_obj.execute(query_update)

# Vuelve a consultar y mostrar algunas filas de la tabla 'INSTRUCTOR' para ver los cambios.
statement = '''SELECT * FROM INSTRUCTOR'''
cursor_obj.execute(statement)

print("Datos actualizados:")
output1 = cursor_obj.fetchmany(2)
for row in output1:
    print(row)

# Importa la librería pandas para trabajar con dataframes.
import pandas as pd

# Recupera los resultados de la consulta en un dataframe de pandas.
df = pd.read_sql_query("SELECT * FROM INSTRUCTOR;", conn)

# Imprime el dataframe completo.
df

# Imprime solo la columna LNAME de la primera fila en el dataframe.
df.LNAME[0]

# Imprime las dimensiones del dataframe (filas, columnas).
df.shape

# Cierra la conexión a la base de datos.
conn.close()

