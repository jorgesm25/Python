from sklearn.linear_model import LinearRegression

#Inicializamos un objeto de regresión
lm = LinearRegression()

# Definimos la variable independiente X como la columna 'highway-mpg' del DataFrame.
X = df[['highway-mpg']]

# Definimos la variable dependiente Y como la columna 'price' del DataFrame.
Y = df['price']

# Ajustamos el modelo de regresión lineal utilizando las variables X (independiente) y Y (dependiente).
lm.fit(X, Y)

# Realizamos predicciones sobre los valores de X utilizando el modelo ajustado y almacenamos los resultados en Yhat.
Yhat = lm.predict(X)

# Mostramos las primeras 5 predicciones.
Yhat[0:5]   

# Obtenemos el valor del intercepto (ordenada al origen) del modelo de regresión lineal.
lm.intercept_ #:38423.31

# Obtenemos el coeficiente (pendiente) de la variable independiente 'highway-mpg' en el modelo de regresión.
lm.coef_ #:- 821.73

# Sustituyendo los valores reales en la ecuación del modelo, obtenemos la siguiente relación:
# Precio = 38423.31 - 821.73 x highway-mpg

