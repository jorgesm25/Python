#------------------------------- ELEGIR LA MEJOR OPCIÓN PARA K ------------------------
import numpy as np
import matplotlib.pyplot as plt
from sklearn.neighbors import KNeighborsClassifier
from sklearn import metrics

# Número máximo de k vecinos a probar
Ks = 10

# Inicializar arrays para almacenar la precisión media y la desviación estándar
mean_acc = np.zeros((Ks-1))
std_acc = np.zeros((Ks-1))

# Bucle para probar diferentes valores de K (número de vecinos)
for n in range(1, Ks):
    
    # Entrenar el modelo y realizar predicciones
    neigh = KNeighborsClassifier(n_neighbors=n).fit(X_train, y_train)
    yhat = neigh.predict(X_test)
    
    # Calcular la precisión y almacenar en el array correspondiente
    mean_acc[n-1] = metrics.accuracy_score(y_test, yhat)
    
    # Calcular la desviación estándar de la precisión
    std_acc[n-1] = np.std(yhat == y_test) / np.sqrt(yhat.shape[0])

# Mostrar la precisión media para cada valor de K
print(mean_acc)

# Crear un gráfico para visualizar la precisión en función del número de vecinos (K)
plt.plot(range(1, Ks), mean_acc, 'g')
plt.fill_between(range(1, Ks), mean_acc - 1 * std_acc, mean_acc + 1 * std_acc, alpha=0.10)
plt.fill_between(range(1, Ks), mean_acc - 3 * std_acc, mean_acc + 3 * std_acc, alpha=0.10, color="green")
plt.legend(('Precisión', '+/- 1xstd', '+/- 3xstd'))
plt.ylabel('Precisión')
plt.xlabel('Número de Vecinos (K)')
plt.tight_layout()
plt.show()

# Imprimir la mejor precisión y el valor de K correspondiente
print("La mejor precisión fue", mean_acc.max(), "con k =", mean_acc.argmax() + 1)
