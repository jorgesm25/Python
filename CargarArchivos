import requests
from bs4 import BeautifulSoup
import pandas as pd

# Define la URL de la página web que contiene los datos de las acciones.
url = "https://cf-courses-data.s3.us.cloud-object-storage.appdomain.cloud/IBMDeveloperSkillsNetwork-PY0220EN-SkillsNetwork/labs/project/amazon_data_webpage.html"

# Realiza una solicitud GET a la URL para obtener el contenido HTML de la página.
html_data = requests.get(url).text

# Crea un objeto BeautifulSoup a partir del HTML descargado utilizando el analizador 'html.parser'.
soup = BeautifulSoup(html_data, 'html.parser')

# Extrae el contenido del título de la página web.
soup.title.string

# Crea un DataFrame vacío con las columnas necesarias para almacenar los datos de la tabla.
amazon_data = pd.DataFrame(columns=["Date", "Open", "High", "Low", "Close", "Adj Close", "Volume"])

# Recorre cada fila de la tabla en el HTML.
for row in soup.find("tbody").find_all("tr"):
    # Encuentra todas las celdas en la fila actual.
    col = row.find_all("td")
    
    # Extrae el texto de cada celda.
    date = col[0].text
    Open = col[1].text
    high = col[2].text
    low = col[3].text
    close = col[4].text
    adj_close = col[5].text
    volume = col[6].text

    # Crea un DataFrame para la fila actual y concatena con el DataFrame principal.
amazon_data = pd.concat([amazon_data, pd.DataFrame({"Date":[date], "Open":[Open], "High":[high], "Low":[low], "Close":[close], "Adj Close":[adj_close], "Volume":[volume]})], ignore_index=True)

# Imprime el valor de la columna 'Open' en la última fila del DataFrame.
amazon_data["Open"].iloc[-1]

