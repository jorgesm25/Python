import pandas as pd 
import xml.etree.ElementTree as etree

# Descargar un archivo XML de ejemplo desde una URL y guardarlo localmente
!curl -o Sample-employee-XML-file.xml https://cf-courses-data.s3.us.cloud-object-storage.appdomain.cloud/IBMDeveloperSkillsNetwork-PY0101EN-SkillsNetwork/labs/Module%205/data/Sample-employee-XML-file.xml

# Parsear (analizar) el archivo XML descargado
tree = etree.parse("Sample-employee-XML-file.xml")

# Obtener la raíz del árbol XML, que es el nodo principal del archivo
root = tree.getroot()

# Definir las columnas para un DataFrame de pandas que almacenará la información del archivo XML
columns = ["firstname", "lastname", "title", "division", "building", "room"]

# Crear un DataFrame vacío con las columnas definidas
datatframe = pd.DataFrame(columns = columns)

# Iterar sobre cada nodo hijo en la raíz del árbol XML (es decir, cada empleado)
for node in root: 
    # Extraer y almacenar el texto de cada subelemento del nodo (nombre, apellido, título, etc.)
    firstname = node.find("firstname").text
    lastname = node.find("lastname").text 
    title = node.find("title").text 
    division = node.find("division").text 
    building = node.find("building").text
    room = node.find("room").text
    
    # Añadir una nueva fila al DataFrame con los valores obtenidos del archivo XML
    datatframe = datatframe.append(pd.Series([firstname, lastname, title, division, building, room], index = columns), ignore_index = True)

# Mostrar el DataFrame resultante con la información del archivo XML
datatframe
