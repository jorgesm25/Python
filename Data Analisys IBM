#Creamos una funcion para graficar modelos polinómicos de una sola variable
def PlotPolly(model, independent_variable, dependent_variabble, Name):
    # Generamos 100 puntos nuevos igualmente espaciados para la variable independiente en el rango de 15 a 55.
    x_new = np.linspace(15, 55, 100)
    # Calculamos los valores correspondientes de la variable dependiente utilizando el modelo polinómico.
    y_new = model(x_new)
    # Graficamos los puntos originales (variable independiente vs. variable dependiente) como puntos '.'.
    # Luego, graficamos la curva del modelo ajustado utilizando una línea '-'.
    plt.plot(independent_variable, dependent_variabble, '.', x_new, y_new, '-')
    # Establecemos el título de la gráfica.
    plt.title('Ajuste Polinómico con Matplotlib para Precio ~ Longitud')
    # Configuramos el color de fondo del gráfico.
    ax = plt.gca()
    ax.set_facecolor((0.898, 0.898, 0.898))
    # Obtenemos la figura actual para realizar configuraciones adicionales si es necesario.
    fig = plt.gcf()
    # Etiquetamos el eje x con el nombre de la variable independiente.
    plt.xlabel(Name)
    # Etiquetamos el eje y con "Price of Cars" (Precio de Autos).
    plt.ylabel('Price of Cars')
    # Mostramos el gráfico en pantalla.
    plt.show()
    # Cerramos la figura para liberar memoria y evitar sobrecargas si se crean múltiples gráficos después.
    plt.close()

